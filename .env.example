# ====================================================================
# Environment Variables — XII PPLG 3 (Commit Terakhir)
# ====================================================================

# 1. Supabase Cloud Adapter (Opsional)
# Jika dikosongkan, seluruh fitur (Buku Tamu, Kapsul Waktu, Voting) otomatis berjalan pada LocalStorage browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Allowlist Email Admin Moderasi (/admin)
# Pisahkan beberapa email dengan tanda koma (tanpa spasi)
NEXT_PUBLIC_ADMIN_EMAILS=admin@tulalit.smk.id,wali.kelas@tulalit.smk.id

# 3. URL Situs Production untuk Open Graph Meta Tags
NEXT_PUBLIC_SITE_URL=https://sogadev-tulalit.vercel.app
